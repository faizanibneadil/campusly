{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "campusly",
  "compatibility_date": "2025-08-15",
  "compatibility_flags": [
    // Enable Node.js API
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#nodejs-compatibility-flag
    "nodejs_compat",
    // Allow to fetch URLs in your app
    // see https://developers.cloudflare.com/workers/configuration/compatibility-flags/#global-fetch-strictly-public
    "global_fetch_strictly_public",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_id": "8bf09a8a-47f9-4cbc-bc24-a49e7ab3751d",
      "database_name": "campusly",
      "remote": true,
    },
  ],
  // Production: campusly.devslix.com
  // Previews:   <preview-name>.campusly.devslix.com
  // see https://developers.cloudflare.com/workers/previews/custom-domains/
  "routes": [
    {
      "pattern": "campusly.devslix.com",
      "custom_domain": true,
      "previews_enabled": true,
    },
  ],
  // Bindings used by Worker Previews (`wrangler preview`).
  // Previews do not inherit the production bindings above.
  // Keep in sync with wrangler.preview.jsonc (used for preview migrations).
  // see https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    "d1_databases": [
      {
        "binding": "D1",
        "database_id": "6eaec123-6d33-4f18-b6dc-713ed16342fa",
        "database_name": "campusly-preview",
      },
    ],
    "r2_buckets": [
      {
        "binding": "R2",
        "bucket_name": "campusly-preview",
      },
    ],
  },
  "services": [
    // The service should match the "name" of your worker
    // {
    //   "binding": "WORKER_SELF_REFERENCE",
    //   "service": "my-app"
    // },
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "campusly",
    },
    // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
    // {
    //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
    //   "bucket_name": "<BUCKET_NAME>",
    // },
  ],

  // Here's how to configure an additional environment
  // It can be deployed with `CLOUDFLARE_ENV=staging pnpm run deploy`
  // "env": {
  //   "staging": {
  //     "name": "my-app-staging",
  //     "d1_databases": [
  //       {
  //         "binding": "D1",
  //         "database_id": "DATABASE_ID",
  //         "database_name": "my-app-staging",
  //         "remote": true
  //       }
  //     ],
  //     "services": [
  //       // The service should match the "name" of your worker
  //       // {
  //       //   "binding": "WORKER_SELF_REFERENCE",
  //       //   "service": "my-app-staging"
  //       // },
  //     ],
  //     "r2_buckets": [
  //       {
  //         "binding": "R2",
  //         "bucket_name": "my-app-staging"
  //       }
  //       // Create a R2 binding with the binding name "NEXT_INC_CACHE_R2_BUCKET"
  //       // {
  //       //   "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //       //   "bucket_name": "<BUCKET_NAME>",
  //       // },
  //     ]
  //   }
  // }
}
